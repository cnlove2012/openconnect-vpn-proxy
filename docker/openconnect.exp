#!/usr/bin/expect -f

# Expect is Tcl plus interactive-process control commands.
set timeout -1
log_user 1
encoding system utf-8

# 检查环境变量
foreach key {VPN_USER VPN_PASSWORD VPN_GATEWAY} {
    if {![info exists env($key)] || $env($key) eq ""} {
        puts stderr "ERROR: $key is required"
        exit 1
    }
}

set vpn_user $env(VPN_USER)
set vpn_password $env(VPN_PASSWORD)
set vpn_gateway $env(VPN_GATEWAY)
set vpn_useragent "AnyConnect Linux_64 5.1.2.42"
set vpn_version "5.1.2.42"
set reconnect_timeout "300"
set vpn_group ""
if {[info exists env(VPN_AUTHGROUP)] && $env(VPN_AUTHGROUP) ne ""} {
    set vpn_group $env(VPN_AUTHGROUP)
}
if {[info exists env(VPN_USERAGENT)] && $env(VPN_USERAGENT) ne ""} {
    set vpn_useragent $env(VPN_USERAGENT)
}
if {[info exists env(VPN_VERSION_STRING)] && $env(VPN_VERSION_STRING) ne ""} {
    set vpn_version $env(VPN_VERSION_STRING)
}
if {[info exists env(VPN_RECONNECT_TIMEOUT)] && $env(VPN_RECONNECT_TIMEOUT) ne ""} {
    set reconnect_timeout $env(VPN_RECONNECT_TIMEOUT)
}

# 避免密码传递给 OpenConnect 子进程
# Keep the password in the Expect process; do not pass it to the OpenConnect child process as an environment variable.
unset env(VPN_PASSWORD)

# 构建命令
# 客户 VPN 网关需要兼容 Cisco AnyConnect 客户端标识。
# 使用经过实际验证的 User-Agent 和版本号。
# 这两个参数已在当前客户环境中验证可以完成 MFA 认证。
set cmd [list \
    openconnect \
    --protocol=anyconnect \
    "--useragent=$vpn_useragent" \
    "--version-string=$vpn_version" \
    --no-dtls \
    --interface=tun0 \
    "--user=$vpn_user" \
    "--authgroup=$vpn_group" \
    --script=/usr/share/vpnc-scripts/vpnc-script \
    "--reconnect-timeout=$reconnect_timeout" \
    $vpn_gateway \
]

puts "Starting Cisco AnyConnect-compatible VPN..."
puts "Gateway: $vpn_gateway"
puts "Group Alias: $vpn_group"
puts "Client User-Agent: $vpn_useragent"
puts "Client Version: $vpn_version"
puts "DTLS: disabled (TLS/CSTP only for this test environment)"

spawn -noecho {*}$cmd
set oc_pid [exp_pid]

# docker stop 时优雅退出 openconnect
# Docker stop sends SIGTERM to PID 1 (Expect, through init when enabled).
# Forward it to OpenConnect and let the container stop cleanly.
trap {
    catch {exec /usr/bin/kill -TERM $oc_pid}
    catch {wait}
    exit 0
} {SIGTERM SIGINT}

set password_sent 0
set otp_sent 0

expect {
    # 注意：expect 按模式在列表中的顺序匹配，而不是按输出位置。
    # 所以 "Login failed" 必须放在 "Password:" 之前，
    # 否则验证码错误时会被 Password: 抢先匹配。
    -re {(?i)(login failed|authentication failed|authentication rejected)} {
        puts stderr "\nVPN login failed."
        puts stderr "Check username/password, or the SMS code was wrong/expired."
        puts stderr "Auth Group: $vpn_group"
        catch {close}
        catch {wait}
        exit 21
    }

    # 自动输入密码（只会输入一次，防止循环重试）
    -re {(?i)Password:} {
        if {$password_sent} {
            puts stderr "\nPassword requested again. Stop to prevent retry loop."
            catch {close}
            catch {wait}
            exit 10
        }

        send -- "$vpn_password\r"
        set vpn_password ""
        set password_sent 1

        puts "\nPassword submitted."
        exp_continue
    }

    # 短信验证码。只匹配英文提示：服务端会连续输出中文和英文两行，如果两行都匹配，第二行会被误判为"验证码被再次要求"。
    # The gateway displays Chinese and English prompts. Match the English line only to avoid treating both lines as two separate OTP challenges.
    -re {(?i)Please input SMS Code:} {
        if {$otp_sent} {
            puts stderr "\nSMS code requested again. Stop authentication."
            catch {close}
            catch {wait}
            exit 11
        }

        send_user "\n请输入【短信】收到的验证码（尽快输入，会过期）: "
        expect_user -re {([^\r\n]+)\r?\n}
        set otp [string trim $expect_out(1,string)]

        send -- "$otp\r"
        set otp ""
        set otp_sent 1

        puts "\nSMS code submitted. Waiting for server response..."
        exp_continue
    }

    # VPN 建立成功（兼容两种输出）
    -re {(?i)(Connected as|Configured as)} {
        puts "\nVPN connected successfully."
        puts "Keep the container running."

        expect eof
        set result [wait]
        exit [lindex $result 3]
    }

    eof {
        set result [wait]
        exit [lindex $result 3]
    }
}
