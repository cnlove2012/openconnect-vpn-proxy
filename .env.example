# Customer Cisco VPN —— 全部替换为你自己的值（真实 .env 永不入库）
# VPN_GATEWAY：VPN 网关地址；VPN_AUTHGROUP：登录组名（网关登录页下拉的组名）
VPN_GATEWAY=https://vpn.example.com
VPN_USER='<vpn_username>'
VPN_PASSWORD='<vpn_password>'
VPN_AUTHGROUP='<vpn_group>'

# These values were used in the successful test in this customer environment.
VPN_USERAGENT='AnyConnect Linux_64 5.1.2.42'
VPN_VERSION_STRING='5.1.2.42'
VPN_RECONNECT_TIMEOUT=300
